name: Security Scan

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  schedule:
    # Run weekly on Monday at 00:00 UTC
    - cron: '0 0 * * 1'
  workflow_dispatch:  # Allow manual trigger

jobs:
  security-audit:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'
          cache: 'pip'
      
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
      
      - name: Install security tools
        run: |
          pip install pip-audit bandit safety
      
      - name: Run pip-audit
        id: pip-audit
        continue-on-error: true
        run: |
          pip-audit --format json --output pip-audit-report.json || true
          pip-audit || true
      
      - name: Run bandit
        id: bandit
        continue-on-error: true
        run: |
          bandit -r . -f json -o bandit-report.json -ll --exclude .git,__pycache__,.pytest_cache,venv || true
          bandit -r . -ll --exclude .git,__pycache__,.pytest_cache,venv || true
      
      - name: Run safety check
        id: safety
        continue-on-error: true
        run: |
          safety check --json --output safety-report.json || true
          safety check || true
      
      - name: Run automated security scanner
        id: security-scan
        continue-on-error: true
        run: |
          python security_scan.py --format json --output security-report.json || true
          python security_scan.py || true
      
      - name: Upload security reports
        uses: actions/upload-artifact@v3
        if: always()
        with:
          name: security-reports
          path: |
            *-report.json
            security-report.json
          retention-days: 90
      
      - name: Check for critical vulnerabilities
        run: |
          # Fail build if critical issues found
          if [ -f pip-audit-report.json ]; then
            CRITICAL_COUNT=$(jq '[.dependencies[].vulns[] | select(.fix_versions)] | length' pip-audit-report.json || echo "0")
            if [ "$CRITICAL_COUNT" -gt "10" ]; then
              echo "::error::Found $CRITICAL_COUNT vulnerabilities!"
              echo "Review the security reports and update dependencies"
              exit 1
            fi
          fi
      
      - name: Comment PR with results
        if: github.event_name == 'pull_request'
        uses: actions/github-script@v6
        with:
          script: |
            const fs = require('fs');
            let comment = '## 🔒 Security Scan Results\n\n';
            
            try {
              const report = JSON.parse(fs.readFileSync('security-report.json', 'utf8'));
              comment += `**Overall Status:** ${report.overall_status}\n\n`;
              
              for (const [check, result] of Object.entries(report.checks)) {
                const emoji = {
                  'pass': '✅',
                  'fail': '❌',
                  'warn': '⚠️',
                  'error': '🔴',
                  'skipped': '⏭️'
                }[result.status] || '❓';
                
                comment += `${emoji} **${check}:** ${result.message}\n`;
              }
              
              comment += '\n📊 [View detailed reports in artifacts](../actions/runs/${{ github.run_id }})';
            } catch (e) {
              comment += 'Security scan completed. Check artifacts for detailed reports.';
            }
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: comment
            });

  dependency-review:
    name: Dependency Review
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Dependency Review
        uses: actions/dependency-review-action@v3
        with:
          fail-on-severity: high
          deny-licenses: GPL-2.0, GPL-3.0

  license-check:
    name: License Compliance
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.12'
      
      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          pip install pip-licenses
      
      - name: Check licenses
        run: |
          pip-licenses --format=markdown --output-file=licenses.md
          pip-licenses --fail-on="GPL-2.0;GPL-3.0"
      
      - name: Upload license report
        uses: actions/upload-artifact@v3
        with:
          name: license-report
          path: licenses.md
