# ========================================
# OPENAI API (Required for all AI agents)
# ========================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# ========================================
# FACEBOOK API (Required for ad posting)
# ========================================
# Get from: https://developers.facebook.com/
FACEBOOK_APP_ID=your-app-id
FACEBOOK_APP_SECRET=your-app-secret
FACEBOOK_ACCESS_TOKEN=your-access-token
FACEBOOK_AD_ACCOUNT_ID=act_your-account-id
FACEBOOK_PAGE_ID=your-page-id

# ========================================
# ENVIRONMENT
# ========================================
# Options: development, staging, production
# - development: Local JSON files, no Firebase
# - staging: Firebase (AI agents write here)
# - production: Protected (agents CANNOT write directly)
ENVIRONMENT=staging

# ========================================
# FIREBASE STAGING (AI agents write here)
# ========================================
# Get from: https://console.firebase.google.com/
# See FIREBASE_SETUP_GUIDE.md for detailed instructions
FIREBASE_PROJECT_ID=metamark-agency-staging
FIREBASE_CREDENTIALS_PATH=./firebase-staging-key.json

# ========================================
# OPTIONAL: Testing & Development
# ========================================
# Uncomment to run without Facebook API (for testing)
# TEST_MODE=true

# ========================================
# OPTIONAL: Rate Limiting
# ========================================
# Uncomment to override default rate limits (requests per minute)
# OPENAI_RATE_LIMIT=50
# FACEBOOK_RATE_LIMIT=200

# ========================================
# OPTIONAL: Budget Alerts
# ========================================
# Uncomment to set default budget alert threshold (percentage)
# BUDGET_ALERT_THRESHOLD=75
