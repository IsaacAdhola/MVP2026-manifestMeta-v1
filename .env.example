# MetaMarkAgency Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# ============================================================================
# OpenAI API (Required for 2 tools)
# ============================================================================
# Used by: AdCopyAgent/AdCopyGenerator, ImageCreatorAgent/ImageGenerator
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# Facebook API (Required for 8 tools)
# ============================================================================
# Used by: All FacebookManagerAgent tools
# Setup guide: https://developers.facebook.com/docs/marketing-api/get-started

# Your Facebook App ID
FACEBOOK_APP_ID=your-app-id-here

# Your Facebook App Secret
FACEBOOK_APP_SECRET=your-app-secret-here

# User or Page Access Token with required permissions:
# - pages_manage_posts
# - pages_show_list
# - ads_management (for paid ads)
FACEBOOK_ACCESS_TOKEN=your-access-token-here

# The Facebook Page ID you want to post to
FACEBOOK_PAGE_ID=your-page-id-here

# ============================================================================
# Scrape Creators API (Required for 5 tools)
# ============================================================================
# Used by: All ResearchAgent Scrape Creators tools
# Get your key from: https://scrapecreators.com (or your API provider)
SCRAPE_CREATORS_API_KEY=your-scrape-creators-key-here

# ============================================================================
# Meta Ad Library Access Token (Optional - fallback only)
# ============================================================================
# Used by: ResearchAgent/MetaAdLibraryKeywordSearch, MetaAdLibraryPageSearch
# Only needed if you want direct Meta Ad Library API access
# The Scrape Creators tools are the primary research tools
# META_AD_LIBRARY_ACCESS_TOKEN=your-meta-ad-library-token-here

# ============================================================================
# Testing Configuration (Optional)
# ============================================================================
# Set to "true" to enable mock mode in tools (when implemented)
# MOCK_MODE=false

# Set to "true" to enable verbose logging
# DEBUG_MODE=false
