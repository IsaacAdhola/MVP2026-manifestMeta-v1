# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Facebook API Configuration
# Get these from: https://developers.facebook.com/
FACEBOOK_APP_ID=your_app_id_here
FACEBOOK_APP_SECRET=your_app_secret_here
FACEBOOK_ACCESS_TOKEN=your_access_token_here

# Facebook Ad Account Configuration
# Find your Ad Account ID in Facebook Ads Manager (format: act_123456789)
FACEBOOK_AD_ACCOUNT_ID=your_ad_account_id_here

# Facebook Page Configuration
# Find your Page ID in your Facebook Page settings
FACEBOOK_PAGE_ID=your_page_id_here

# Slack (Socket Mode locally; HTTP Events API on Cloud Functions)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_CHANNEL_ID=C12345678

# Firebase staging (non-secret)
ENVIRONMENT=staging
FIREBASE_PROJECT_ID=manifest-ai-meta
FIREBASE_CREDENTIALS_PATH=./manifest-ai-meta-firebase-adminsdk-fbsvc-098306794e.json
AGENT_MODEL_NAME=gpt-4o

# Note: Copy this file to .env and fill in your actual values
# Slack bot token, signing secret, and LLM keys must go in Secret Manager
# before `firebase deploy --only functions`. Do not put them in functions/.env.

# OPTIONAL: Telegram (customer channel later — not required)
# Empty on purpose. Unused until a customer asks. Not the Slack heartbeat.
# Do not invent tokens. Do not commit real values. See docs/CUSTOMER_CHANNELS.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Offline canned desk — default OFF. Live Slack / client turns must leave this unset.
# MANIFEST_AI_DEMO=1





